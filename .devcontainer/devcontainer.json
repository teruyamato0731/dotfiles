{
  "name": "dotfiles-ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "target": "dev"
  },
  "remoteUser": "ubuntu",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ubuntu/dotfiles,type=bind",
  "workspaceFolder": "/home/ubuntu/dotfiles",
  "initializeCommand": "mkdir -p ${localWorkspaceFolder}/.cache",
  "postCreateCommand": [
    "./install.sh"
  ],
  "containerEnv": {
    "HISTFILE": "${containerWorkspaceFolder}/.cache/.bash_history"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "yzhang.markdown-all-in-one",
        "docker.docker",
        "timonwong.shellcheck"
      ]
    }
  }
}

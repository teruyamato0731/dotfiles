{
  "name": "dotfiles-ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "target": "dev"
  },
  "remoteUser": "ubuntu",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/ubuntu/dotfiles,type=bind",
  "workspaceFolder": "/home/ubuntu/dotfiles",
  "initializeCommand": [
    "mkdir",
    "-p",
    "${localWorkspaceFolder}/.cache/xdg-cache",
    "${localWorkspaceFolder}/.cache/xdg-state/bash"
  ],
  "postCreateCommand": [
    "./install.sh"
  ],
  "containerEnv": {
    "XDG_CACHE_HOME": "${containerWorkspaceFolder}/.cache/xdg-cache",
    "XDG_STATE_HOME": "${containerWorkspaceFolder}/.cache/xdg-state",
    "HISTFILE": "${containerWorkspaceFolder}/.cache/xdg-state/bash/history"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "yzhang.markdown-all-in-one",
        "docker.docker",
        "timonwong.shellcheck"
      ]
    }
  }
}
